# ---------------- Telegram ----------------
# token from @BotFather
BOT_TOKEN=123456:ABC-your-bot-token
# optional (aiogram only needs BOT_TOKEN, kept for completeness)
API_ID=0
API_HASH=

# HTTP/SOCKS proxy used to reach Telegram servers
# examples: http://user:pass@127.0.0.1:8888  or  socks5://127.0.0.1:1080
USE_PROXY=false
PROXY_URL=

# Restrict song ingestion to one group chat id (e.g. -1001234567890).
# Leave empty to accept audios from every group the bot lives in.
PERSONA_CHAT_ID=

# Used to build public message links for pinned songs.
# Public group  -> link is built automatically: https://t.me/<group_username>/<message_id>
# Private group -> paste any permanent invite link here (without the /invite/ prefix):
CHAT_LINK_TEMPLATE=

# TMA link (https://t.me/PersonaBot/app). Used for the "Open Chart" button.
WEBAPP_URL=https://t.me/PersonaBot/app

# ---------------- Database ----------------
DATABASE_URL=sqlite:///./data/persona.db

# ---------------- Server ----------------
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=*

# Secret used to sign dev-login tokens (change it!)
SECRET_KEY=change-me-please

# Dev login lets the app be used in a normal browser (outside Telegram).
# Disable in production.
ALLOW_DEV_LOGIN=true

# Disable bot polling (useful when you only want the API)
DISABLE_POLLING=false

# ---------------- Playlist playback ----------------
# seconds between forwarded songs (Telegram limits ~20 msg/min per chat)
PLAY_SONG_INTERVAL=1.5
PLAY_MAX_SONGS=50
PLAY_INTRO=true
