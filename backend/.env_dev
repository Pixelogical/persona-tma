# ---------------- Telegram ----------------
# token from @BotFather  (rotate it with /revoke if it ever leaked into git!)
BOT_TOKEN=1858481331:AAFYDXqiWrnxegbgZRL6fp6EOT5VP2mCzYs
# optional (aiogram only needs BOT_TOKEN, kept for completeness)
API_ID=0
API_HASH=

# HTTP/SOCKS proxy used to reach Telegram servers
# examples: http://user:pass@127.0.0.1:8888  or  socks5://127.0.0.1:1080
USE_PROXY=false
PROXY_URL=

# Restrict song ingestion to one group chat id.
# Group ids are negative, e.g. -3784999585 or its supergroup form -1003784999585.
# The two forms are treated as the SAME group automatically.
# Leave empty to accept mp3s from any group + DMs.
PERSONA_CHAT_ID=-3784999585

# How to decide which chat songs come from:
#   0 = match by PERSONA_CHAT_ID
#   1 = match by GROUP_NAME (exact group title)
SEARCH_TYPE=0
GROUP_NAME=Persona

# Used to build public message links for pinned songs.
# Public group  -> link is built automatically: https://t.me/<group_username>/<message_id>
# Private group -> paste any permanent invite link here (without the /invite/ prefix):
CHAT_LINK_TEMPLATE=

# TMA link. Used for the "Open Chart" button.
# Must match the domain set in BotFather (/newapp or menu button): tma.pixelhs.ir
WEBAPP_URL=https://tma.pixelhs.ir

# ---------------- Database ----------------
DATABASE_URL=sqlite:///./data/persona.db

# ---------------- Server ----------------
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=*

# Secret used to sign dev-login tokens (change it!)
SECRET_KEY=change-me-please

# Dev login lets the app be used in a normal browser (outside Telegram).
# Keep OFF: users sign in permanently with their Telegram account only.
# Flip to true ONLY temporarily for local browser testing.
ALLOW_DEV_LOGIN=false

# Disable bot polling (useful when you only want the API)
DISABLE_POLLING=false

# ---------------- Playlist playback ----------------
# seconds between songs sent to your DM with the bot
PLAY_SONG_INTERVAL=1.5
PLAY_MAX_SONGS=50
PLAY_INTRO=true

# ---------------- last.fm ----------------
# enriches new songs with genres (top tags), cover art and global listeners
LASTFM_ENABLED=true
LASTFM_API_KEY=63b36d947fd8fcb048a6dbd0f7b0dbf6
LASTFM_SHARED_SECRET=6e6b238ca67ead1ff281d5c92f4aa259
